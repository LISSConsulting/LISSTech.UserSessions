# -----------------------------------------------------------------------------
# LISSTech.UserSessions — build/release environment variables
# Copy to `.env` and populate the values you need. `.env` is gitignored.
# -----------------------------------------------------------------------------

# SHA-1 thumbprint of the code-signing certificate in the local Windows cert
# store. Used by `just sign` and (transitively) `just release` / `just publish`.
# Omit to skip signing locally (CI/CD and published builds always sign).
# CODE_SIGNING_CERTIFICATE_THUMBPRINT=AA11BB22CC33DD44EE55FF6677889900AABBCCDD

# PSGallery API key — generate at https://www.powershellgallery.com/account/apikeys
# with scope limited to the LISSTech.UserSessions package.
# Required for `just publish`.
# PSGALLERY_API_KEY=oy2abcdef0123456789abcdef0123456789abcdef0

# Optional: override the default target module path installed by `just install`.
# Default is "$env:ProgramFiles\WindowsPowerShell\Modules" on Windows PS 5.1.
# MODULE_INSTALL_PATH=C:\Users\you\Documents\PowerShell\Modules
